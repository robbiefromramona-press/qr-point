# Copy this file to .env for local dev (netlify dev reads it automatically),
# and set the same two values in Netlify's dashboard for the deployed site:
# Site settings > Environment variables.

# Supabase project URL — Project Settings > API > Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase SERVICE ROLE key (NOT the anon/public key) — Project Settings > API > service_role
# This key bypasses Row Level Security, which is why it only ever lives in
# Netlify Functions (server-side) and is never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
